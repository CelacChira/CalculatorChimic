<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Formula chimică (ex: H2O, NaCl):"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/entry_formula"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="ex: H2SO4" />

        <Button
            android:id="@+id/btn_calculeaza_masa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Calculează Masa și Părțile" />

        <TextView
            android:id="@+id/rezultat_masa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Introduceți datele"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
